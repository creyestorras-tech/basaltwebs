---
import Sector from '../../components/Sector.astro';
import { sectors } from '../../i18n/sectors';

export function getStaticPaths() {
  return sectors.map((sector) => ({ params: { slug: sector.text.ca.slug }, props: { sector } }));
}
const { sector } = Astro.props;
---
<Sector lang="ca" sector={sector} />
