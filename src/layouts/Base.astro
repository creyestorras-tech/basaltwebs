---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';
import { site, whatsapp, type Lang } from '../config/site';
import { dict, rutes } from '../i18n/content';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  // Ruta equivalent en l'altre idioma
  alt: { ca: string; es: string };
  home?: boolean;
}

const { lang, title, description, alt, home = false } = Astro.props;
const t = dict[lang];
const r = rutes[lang];
const canonical = new URL(alt[lang], site.url).href;
const ogImage = new URL(lang === 'ca' ? '/og.jpg' : '/og-es.jpg', site.url).href;
const anchor = (id: string) => (home ? `#${id}` : `${r.home}#${id}`);
const nav = [
  { id: 'prova', label: t.nav.demo },
  { id: 'exemples', label: t.nav.exemples },
  { id: 'com-funciona', label: t.nav.com },
  { id: 'preu', label: t.nav.preu },
  { id: 'preguntes', label: t.nav.faq },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.nom,
  url: site.url,
  description: dict[lang].meta.description,
  telephone: `+${site.mobil}`,
  email: site.correu,
  image: new URL('/og.jpg', site.url).href,
  address: { '@type': 'PostalAddress', addressLocality: 'Olot', addressRegion: 'Girona', addressCountry: 'ES' },
  areaServed: { '@type': 'AdministrativeArea', name: 'Catalunya' },
  founder: { '@type': 'Person', name: site.persona },
  knowsLanguage: ['ca', 'es'],
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="ca" href={new URL(alt.ca, site.url).href} />
    <link rel="alternate" hreflang="es" href={new URL(alt.es, site.url).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(alt.ca, site.url).href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/img/basalt.webp" as="image" type="image/webp" fetchpriority="high" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#131517" />
    <meta name="color-scheme" content="dark light" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.nom} />
    <meta property="og:locale" content={lang === 'ca' ? 'ca_ES' : 'es_ES'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {home && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline>document.documentElement.classList.add('js');</script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#contingut">{t.nav.saltar}</a>

    <header class="header" data-header>
      <div class="wrap header-in">
        <a href={r.home} class="brand" aria-label={`${site.nom}, ${t.nav.inici.toLowerCase()}`}>
          <Logo />
        </a>
        <nav class="nav" aria-label={lang === 'ca' ? 'Seccions' : 'Secciones'}>
          {nav.map((n) => <a href={anchor(n.id)}>{n.label}</a>)}
        </nav>
        <div class="header-end">
          <div class="lang" role="group" aria-label={t.nav.idioma}>
            <a href={alt.ca} hreflang="ca" lang="ca" aria-current={lang === 'ca' ? 'true' : undefined}>CA</a>
            <span aria-hidden="true"></span>
            <a href={alt.es} hreflang="es" lang="es" aria-current={lang === 'es' ? 'true' : undefined}>ES</a>
          </div>
          <a class="btn header-cta" href={whatsapp(lang)} target="_blank" rel="noopener">
            <Icon name="whatsapp" />
            <span>{t.hero.cta}</span>
          </a>
        </div>
      </div>
    </header>

    <main id="contingut">
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap footer-in">
        <div class="footer-brand">
          <Logo />
          <p>{t.peu.origen}</p>
        </div>
        <nav class="footer-links" aria-label="Legal">
          <a href={r.avis}>{t.peu.avis}</a>
          <a href={r.privacitat}>{t.peu.privacitat}</a>
        </nav>
        <p class="footer-small">
          © {new Date().getFullYear()} {site.nom} · {site.titular}.{' '}
          {t.peu.fotos}: <a href={site.foto.url} rel="noopener" target="_blank">{site.foto.autor}</a> i{' '}
          <a href={site.textura.url} rel="noopener" target="_blank">{site.textura.autor}</a> {t.peu.a} Unsplash.
        </p>
      </div>
    </footer>

    {home && (
      <a class="btn fab" href={whatsapp(lang)} target="_blank" rel="noopener" data-fab tabindex="-1" aria-hidden="true">
        <Icon name="whatsapp" />
        <span>{t.hero.cta}</span>
      </a>
    )}

    <script>
      const els = document.querySelectorAll<HTMLElement>('[data-set]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-set');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -6% 0px', threshold: 0.08 },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-set'));
      }

      // Botó flotant de WhatsApp al mòbil: visible un cop passada la portada,
      // amagat a la filada de contacte.
      const fab = document.querySelector<HTMLElement>('[data-fab]');
      const hero = document.querySelector<HTMLElement>('[data-hero]');
      const contact = document.querySelector<HTMLElement>('#contacte');
      let pastHero = false;
      let atContact = false;
      const sync = () => {
        const on = pastHero && !atContact;
        fab?.classList.toggle('is-on', on);
        fab?.setAttribute('aria-hidden', String(!on));
        fab?.setAttribute('tabindex', on ? '0' : '-1');
      };
      if (fab && hero && contact) {
        new IntersectionObserver(([e]) => { pastHero = !e.isIntersecting; sync(); }).observe(hero);
        new IntersectionObserver(([e]) => { atContact = e.isIntersecting; sync(); }).observe(contact);
      }
    </script>
  </body>
</html>

<style>
  .skip {
    position: fixed;
    top: 8px;
    left: 8px;
    z-index: 100;
    padding: 10px 16px;
    border-radius: var(--r);
    background: var(--lichen);
    color: var(--ink);
    font-weight: 650;
    transform: translateY(-160%);
    transition: transform 200ms var(--ease-out);
  }
  .skip:focus {
    transform: none;
  }

  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    padding-top: env(safe-area-inset-top, 0px);
    background: rgb(19 21 23 / 0.94);
    border-bottom: 2px solid var(--bed);
    color: var(--chalk);
  }
  @supports (backdrop-filter: blur(1px)) {
    .header {
      background: rgb(19 21 23 / 0.94);
      backdrop-filter: blur(12px) saturate(120%);
      -webkit-backdrop-filter: blur(12px) saturate(120%);
    }
  }
  .header-in {
    display: flex;
    align-items: center;
    gap: 28px;
    height: var(--header-h);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--chalk);
    text-decoration: none;
    user-select: none;
    -webkit-user-select: none;
  }
  .nav {
    display: none;
    gap: 2px;
  }
  .nav a {
    padding: 10px 12px;
    color: var(--mist);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 150ms ease;
  }
  .header-end {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-left: auto;
  }
  .lang {
    display: flex;
    align-items: center;
    font-size: 0.8125rem;
    font-weight: 650;
    letter-spacing: 0.06em;
  }
  .lang span {
    width: 1px;
    height: 14px;
    background: var(--slate-2);
  }
  .lang a {
    display: grid;
    place-items: center;
    min-width: 44px;
    min-height: 44px;
    color: var(--mist);
    text-decoration: none;
    user-select: none;
    -webkit-user-select: none;
    transition: color 150ms ease;
  }
  .lang a[aria-current] {
    color: var(--lichen);
  }
  .header-cta {
    display: none;
    min-height: 42px;
    padding: 0 16px;
    font-size: 0.9375rem;
    gap: 8px;
  }
  .header-cta :global(svg) {
    width: 18px;
    height: 18px;
  }

  @media (hover: hover) and (pointer: fine) {
    .nav a:hover,
    .lang a:not([aria-current]):hover {
      color: var(--chalk);
    }
  }
  @media (min-width: 640px) {
    .header-cta {
      display: inline-flex;
    }
  }
  @media (min-width: 1040px) {
    .nav {
      display: flex;
    }
  }

  .footer {
    padding-block: 56px calc(40px + env(safe-area-inset-bottom, 0px));
    background: var(--bed);
    color: var(--mist);
  }
  .footer-in {
    display: grid;
    gap: 28px;
  }
  .footer-brand {
    display: grid;
    gap: 10px;
    color: var(--chalk);
  }
  .footer-brand p {
    color: var(--mist);
    font-size: 0.9375rem;
  }
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 24px;
  }
  .footer-links a {
    display: inline-block;
    padding-block: 8px;
    color: var(--mist-2);
    font-size: 0.9375rem;
  }
  .footer-small {
    font-size: 0.8125rem;
    line-height: 1.6;
  }
  @media (min-width: 760px) {
    .footer-in {
      grid-template-columns: 1fr auto;
      align-items: center;
    }
    .footer-small {
      grid-column: 1 / -1;
      padding-top: 24px;
      border-top: 2px solid var(--basalt-2);
    }
  }

  .fab {
    position: fixed;
    right: max(16px, env(safe-area-inset-right, 0px));
    bottom: calc(16px + env(safe-area-inset-bottom, 0px));
    z-index: 40;
    padding: 0 20px 0 16px;
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.28) inset,
      0 10px 24px -8px rgb(0 0 0 / 0.55);
    opacity: 0;
    transform: translateY(calc(100% + 24px));
    pointer-events: none;
    transition:
      transform 320ms var(--ease-out),
      opacity 200ms ease;
  }
  .fab:global(.is-on) {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  .fab:global(.is-on):active {
    transform: scale(0.97);
  }
  @media (min-width: 760px) {
    .fab {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .fab {
      transform: none;
    }
  }
</style>
