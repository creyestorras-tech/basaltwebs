---
import WhatsappIcon from '../components/WhatsappIcon.astro';
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { site, whatsapp, type Lang } from '../config/site';
import { dict, rutes } from '../i18n/content';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  // Ruta equivalent en l'altre idioma
  alt: { ca: string; es: string };
  home?: boolean;
}

const { lang, title, description, alt, home = false } = Astro.props;
const t = dict[lang];
const r = rutes[lang];
const canonical = new URL(alt[lang], site.url).href;
const ogImage = new URL('/og.jpg', site.url).href;
const anchor = (id: string) => (home ? `#${id}` : `${r.home}#${id}`);
const nav = [
  { id: 'com-funciona', label: t.nav.com },
  { id: 'que-inclou', label: t.nav.inclou },
  { id: 'preus', label: t.nav.preus },
  { id: 'preguntes', label: t.nav.faq },
];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="ca" href={new URL(alt.ca, site.url).href} />
    <link rel="alternate" hreflang="es" href={new URL(alt.es, site.url).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(alt.ca, site.url).href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#1a1c1e" />
    <meta name="color-scheme" content="light" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.nom} />
    <meta property="og:locale" content={lang === 'ca' ? 'ca_ES' : 'es_ES'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#contingut">{t.nav.saltar}</a>

    <header class="header" data-header>
      <div class="wrap header-in">
        <a href={r.home} class="brand" aria-label={`${site.nom} — ${lang === 'ca' ? 'inici' : 'inicio'}`}>
          <Logo />
        </a>
        <nav class="nav" aria-label={lang === 'ca' ? 'Principal' : 'Principal'}>
          {nav.map((n) => <a href={anchor(n.id)}>{n.label}</a>)}
        </nav>
        <div class="header-end">
          <div class="lang" role="group" aria-label={t.nav.idioma}>
            <a href={alt.ca} hreflang="ca" lang="ca" aria-current={lang === 'ca' ? 'true' : undefined}>CA</a>
            <span aria-hidden="true">|</span>
            <a href={alt.es} hreflang="es" lang="es" aria-current={lang === 'es' ? 'true' : undefined}>ES</a>
          </div>
          <a class="btn btn-accent header-cta" href={anchor('contacte')}>{t.nav.contacte}</a>
        </div>
      </div>
    </header>

    <main id="contingut">
      <slot />
    </main>

    <footer class="footer dark">
      <div class="wrap footer-in">
        <div class="footer-brand">
          <Logo />
          <p>{lang === 'ca' ? 'Fet a la Garrotxa, per a negocis de tot arreu' : 'Hecho en la Garrotxa, para negocios de todas partes'}</p>
        </div>
        <nav class="footer-links" aria-label="Legal">
          <a href={r.avis}>{t.peu.avis}</a>
          <a href={r.privacitat}>{t.peu.privacitat}</a>
        </nav>
        <p class="footer-small">
          © {new Date().getFullYear()} {site.nom}. {t.peu.foto}{' '}
          <a href={site.foto.url} rel="noopener" target="_blank">{site.foto.autor}</a> {t.peu.a} Unsplash.
        </p>
      </div>
    </footer>

    {home && (
      <a class="btn btn-accent fab" href={whatsapp(lang)} target="_blank" rel="noopener" data-fab aria-label={`${t.hero.cta}`}>
        <WhatsappIcon />
        <span>{t.mobilCta}</span>
      </a>
    )}

    <script>
      // Aparicions en fer scroll (una sola vegada)
      const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-in'));
      }

      // Capçalera: vora quan hi ha scroll. Botó flotant de WhatsApp: visible
      // un cop passada la portada i amagat a la secció de contacte.
      const header = document.querySelector<HTMLElement>('[data-header]');
      const fab = document.querySelector<HTMLElement>('[data-fab]');
      const hero = document.querySelector<HTMLElement>('[data-hero]');
      const contact = document.querySelector<HTMLElement>('#contacte');
      let pastHero = false;
      let atContact = false;
      const syncFab = () => fab?.classList.toggle('is-on', pastHero && !atContact);
      const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
      if (fab && hero && contact) {
        new IntersectionObserver(([e]) => { pastHero = !e.isIntersecting; syncFab(); }).observe(hero);
        new IntersectionObserver(([e]) => { atContact = e.isIntersecting; syncFab(); }).observe(contact);
      }
    </script>
  </body>
</html>

<style>
  .skip {
    position: fixed;
    top: 8px;
    left: 8px;
    z-index: 100;
    padding: 10px 16px;
    border-radius: 999px;
    background: var(--white);
    color: var(--basalt-900);
    font-weight: 600;
    transform: translateY(-160%);
    transition: transform 200ms var(--ease-out);
  }
  .skip:focus {
    transform: none;
  }

  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    padding-top: env(safe-area-inset-top, 0px);
    background: rgb(26 28 30 / 0.86);
    backdrop-filter: saturate(140%) blur(14px);
    -webkit-backdrop-filter: saturate(140%) blur(14px);
    color: var(--stone-100);
    box-shadow: 0 1px 0 rgb(255 255 255 / 0);
    transition: box-shadow 200ms ease;
  }
  .header:global(.is-scrolled) {
    box-shadow: 0 1px 0 rgb(255 255 255 / 0.08);
  }
  .header-in {
    display: flex;
    align-items: center;
    gap: 24px;
    height: var(--header-h);
  }
  .brand {
    text-decoration: none;
    color: var(--white);
    --logo-facet: rgb(26 28 30 / 0.35);
    user-select: none;
    -webkit-user-select: none;
  }
  .brand :global(svg path:first-child) {
    fill: var(--stone-200);
  }
  .nav {
    display: none;
    gap: 4px;
    margin-left: auto;
  }
  .nav a {
    padding: 8px 12px;
    border-radius: 999px;
    color: #b9bbbd;
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 150ms ease;
  }
  .header-end {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-left: auto;
  }
  .lang {
    display: flex;
    align-items: center;
    gap: 2px;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--basalt-600);
  }
  .lang a {
    display: grid;
    place-items: center;
    min-width: 40px;
    min-height: 40px;
    border-radius: 999px;
    color: var(--stone-400);
    text-decoration: none;
    user-select: none;
    -webkit-user-select: none;
    transition: color 150ms ease, background-color 150ms ease;
  }
  .lang a[aria-current] {
    color: var(--white);
    background: rgb(255 255 255 / 0.09);
  }
  .header-cta {
    display: none;
    min-height: 40px;
    padding: 0 18px;
    font-size: 0.9375rem;
  }

  @media (hover: hover) and (pointer: fine) {
    .nav a:hover,
    .lang a:not([aria-current]):hover {
      color: var(--white);
    }
  }

  @media (min-width: 640px) {
    .header-cta {
      display: inline-flex;
    }
  }
  @media (min-width: 1000px) {
    .nav {
      display: flex;
    }
    .header-end {
      margin-left: 8px;
    }
  }

  .footer {
    padding-block: 48px calc(40px + env(safe-area-inset-bottom, 0px));
    background: var(--basalt-950);
  }
  .footer-in {
    display: grid;
    gap: 24px;
  }
  .footer-brand {
    display: grid;
    gap: 8px;
    color: var(--white);
    --logo-facet: rgb(18 19 20 / 0.4);
  }
  .footer-brand :global(svg path:first-child) {
    fill: var(--stone-200);
  }
  .footer-brand p {
    color: var(--stone-400);
    font-size: 0.9375rem;
  }
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
  }
  .footer-links a {
    color: var(--stone-200);
    font-size: 0.9375rem;
    text-underline-offset: 4px;
    text-decoration-color: rgb(255 255 255 / 0.25);
  }
  .footer-small {
    color: var(--stone-500);
    font-size: 0.8125rem;
  }
  @media (min-width: 760px) {
    .footer-in {
      grid-template-columns: 1fr auto;
      align-items: center;
    }
    .footer-small {
      grid-column: 1 / -1;
      padding-top: 20px;
      border-top: 1px solid rgb(255 255 255 / 0.07);
    }
  }

  /* Botó flotant de WhatsApp (només mòbil) */
  .fab {
    position: fixed;
    right: max(16px, env(safe-area-inset-right, 0px));
    bottom: calc(16px + env(safe-area-inset-bottom, 0px));
    z-index: 40;
    min-height: 52px;
    padding: 0 20px 0 16px;
    opacity: 0;
    transform: translateY(calc(100% + 24px));
    pointer-events: none;
    transition:
      transform 300ms var(--ease-out),
      opacity 200ms ease,
      background-color 200ms ease;
  }
  .fab:global(.is-on) {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  .fab:global(.is-on):active {
    transform: scale(0.97);
  }
  @media (min-width: 760px) {
    .fab {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .fab {
      transform: none;
    }
  }
</style>
