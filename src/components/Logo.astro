---
// Marca: la secció hexagonal d'una columna de basalt, amb un punt de liquen.
interface Props { class?: string }
const { class: cls } = Astro.props;
---
<span class:list={['logo', cls]}>
  <svg viewBox="0 0 32 32" width="26" height="26" aria-hidden="true">
    <path d="M16 2.5 27.7 9.25v13.5L16 29.5 4.3 22.75V9.25Z" fill="#3a3f44" />
    <path d="M16 9 21.6 12.25v6.5L16 22l-5.6-3.25v-6.5Z" fill="#24282c" />
    <path d="M16 2.5V9M27.7 9.25l-6.1 3M27.7 22.75l-6.1-4M16 29.5V22M4.3 22.75l6.1-4M4.3 9.25l6.1 3" stroke="#131517" stroke-width="1.3" />
    <circle cx="16" cy="15.5" r="2.5" fill="#e3a12f" />
  </svg>
  <span class="logo-text">Basalt <span>Webs</span></span>
</span>
<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--display);
    font-size: 1.25rem;
    letter-spacing: 0.01em;
  }
  .logo-text span {
    color: var(--mist);
  }
</style>
