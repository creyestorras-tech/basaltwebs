---
import '@fontsource-variable/oswald';
import '@fontsource-variable/bodoni-moda/opsz-italic.css';
import '@fontsource/young-serif';
import { type Lang } from '../config/site';
import { dict, exemples } from '../i18n/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dict[lang].exemples;
const tr = t.tramuntana;
const al = t.alba;
const se = t.serena;
const hores = ['10:00', '11:30', '13:00', '16:30', '18:00', '19:30'];
---
<!-- Cada negoci, el seu estil: panells grans que passen en horitzontal -->
<section class="course course-lime ex-course" id="exemples">
  <div class="ex-pin">
    <div class="wrap">
      <div class="head" data-set>
        <h2 class="h2">{t.titol}</h2>
        <p class="lede">{t.text}</p>
      </div>
    </div>

    <ul class="ex-track">
      <!-- Barberia Tramuntana: fosca, urbana, negre i daurat -->
      <li class="ex-item">
        <figure class="ex-figure">
          <div class="ex-panel ex-tramuntana" role="img" aria-label={`${t.alt} ${exemples[0].nom}`}>
            <div class="ex-inner" aria-hidden="true">
              <span class="ex-tag">{t.etiqueta}</span>
              <header class="tr-nav">
                <span class="tr-logo">Tramuntana</span>
                <span class="tr-links">{tr.nav.map((n) => <span>{n}</span>)}</span>
                <span class="tr-btn tr-btn-sm">{tr.cta}</span>
              </header>
              <div class="tr-body">
                <div class="tr-copy">
                  <p class="tr-kick">Barberia</p>
                  <p class="tr-title">{tr.titol}</p>
                  <p class="tr-text">{tr.text}</p>
                  <span class="tr-btn">{tr.cta}</span>
                </div>
                <ul class="tr-list">
                  {tr.serveis.map(([n, d]) => (
                    <li><span>{n}</span><span>{d}</span></li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
          <figcaption>{exemples[0].nom} · {exemples[0].tipus[lang]} <span class="ex-cap-tag">{t.etiqueta}</span></figcaption>
        </figure>
      </li>

      <!-- Centre d'estètica Alba: clara, rosa pàl·lid, elegant -->
      <li class="ex-item">
        <figure class="ex-figure">
          <div class="ex-panel ex-alba" role="img" aria-label={`${t.alt} ${exemples[1].nom}`}>
            <div class="ex-inner" aria-hidden="true">
              <span class="ex-tag">{t.etiqueta}</span>
              <header class="al-nav">
                <span class="al-logo">alba</span>
                <span class="al-links">{al.nav.map((n) => <span>{n}</span>)}</span>
              </header>
              <div class="al-body">
                <div class="al-copy">
                  <p class="al-title">{al.titol}</p>
                  <p class="al-text">{al.text}</p>
                  <span class="al-btn">{al.cta}</span>
                </div>
                <div class="al-menu">
                  <p class="al-menu-title">{al.carta}</p>
                  <ul>
                    {al.serveis.map(([n, d]) => (
                      <li><span>{n}</span><i></i><span>{d}</span></li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          </div>
          <figcaption>{exemples[1].nom} · {exemples[1].tipus[lang]} <span class="ex-cap-tag">{t.etiqueta}</span></figcaption>
        </figure>
      </li>

      <!-- Massatges Serena: natural, fusta i verd -->
      <li class="ex-item">
        <figure class="ex-figure">
          <div class="ex-panel ex-serena" role="img" aria-label={`${t.alt} ${exemples[2].nom}`}>
            <div class="ex-inner" aria-hidden="true">
              <span class="ex-tag">{t.etiqueta}</span>
              <div class="se-wood">
                <span class="se-logo">Serena</span>
                <p class="se-title">{se.titol}</p>
                <span class="se-links">{se.nav.map((n) => <span>{n}</span>)}</span>
              </div>
              <div class="se-book">
                <p class="se-service">{se.servei}</p>
                <p class="se-step">{se.pas}</p>
                <div class="se-days">
                  {se.dies.map((d, i) => (
                    <span class:list={{ on: i === 2 }}><small>{d}</small>{12 + i}</span>
                  ))}
                </div>
                <div class="se-slots">
                  {hores.map((h, i) => <span class:list={{ on: i === 3 }}>{h}</span>)}
                </div>
                <span class="se-btn">{se.cta}</span>
              </div>
            </div>
          </div>
          <figcaption>{exemples[2].nom} · {exemples[2].tipus[lang]} <span class="ex-cap-tag">{t.etiqueta}</span></figcaption>
        </figure>
      </li>
    </ul>
  </div>
</section>

<style>
  .head {
    display: grid;
    gap: 18px;
    max-width: 44rem;
    margin-bottom: clamp(36px, 5vw, 56px);
  }
  /* ---------- Estructura: una cinta de panells grans ---------- */
  .ex-course {
    overflow-x: clip;
  }
  .ex-track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(86vw, 1080px);
    gap: 20px;
    margin: 0;
    padding: 8px var(--gutter) 28px;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }
  .ex-track::-webkit-scrollbar {
    display: none;
  }
  .ex-item {
    scroll-snap-align: start;
  }
  .ex-figure {
    margin: 0;
  }
  .ex-figure figcaption {
    /* Fons propi: quan el panell és fora de la pantalla, el text continua tenint contrast */
    background: var(--lime);
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 14px;
    color: var(--ink-muted);
    font-size: 0.9375rem;
  }
  .ex-cap-tag {
    padding: 2px 8px;
    border-radius: var(--r);
    box-shadow: inset 0 0 0 1.5px var(--joint-lime);
    font-size: 0.75rem;
    font-weight: 650;
  }

  /* El panell: la web a tota la superfície, vores arrodonides i ombra suau */
  .ex-panel {
    container-type: inline-size;
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: 18px;
    overflow: hidden;
    box-shadow:
      0 1px 2px rgb(22 24 26 / 0.06),
      0 24px 50px -28px rgb(22 24 26 / 0.45);
  }
  .ex-inner {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    /* Fora de pantalla no es dibuixa: les seves tipografies es descarreguen quan cal */
    content-visibility: auto;
  }
  .ex-tag {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 2;
    padding: 3px 9px;
    border-radius: 999px;
    font: 650 11px/1.4 var(--text);
    letter-spacing: 0.02em;
  }
  @media (min-width: 760px) {
    .ex-track {
      gap: 32px;
    }
    .ex-panel {
      aspect-ratio: 16 / 10;
    }
  }

  /* A l'escriptori: la secció es fixa i els panells passen en horitzontal en fer scroll */
  @supports (animation-timeline: view()) {
    @media (min-width: 960px) and (prefers-reduced-motion: no-preference) {
      .ex-course {
        height: 300vh;
        padding-block: 0;
        view-timeline-name: --exemples;
      }
      .ex-pin {
        background: var(--lime);
        position: sticky;
        top: var(--header-h);
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        align-content: center;
        min-height: calc(100vh - var(--header-h));
        padding-block: 24px;
      }
      .ex-pin .head {
        margin-bottom: 28px;
      }
      .ex-track {
        grid-auto-columns: min(1080px, 74vw, calc((100vh - 330px) * 1.6));
        width: max-content;
        overflow: visible;
        scroll-snap-type: none;
        padding-inline: max(var(--gutter), calc((100vw - var(--wrap)) / 2 + var(--gutter)));
        /* La línia de temps va en una variable: així el minificador no la fusiona dins
           de la propietat abreujada «animation», que el navegador descartaria */
        --tl: --exemples;
        animation: ex-pan linear both;
        animation-timeline: var(--tl);
        animation-range: contain 0% contain 100%;
      }
      @keyframes ex-pan {
        to {
          transform: translateX(calc(-100% + 100vw));
        }
      }
    }
  }

  /* ---------- Barberia Tramuntana ---------- */
  .ex-tramuntana {
    --gold: #c9a24a;
    background:
      repeating-linear-gradient(-45deg, rgb(201 162 74 / 0.045) 0 2px, transparent 2px 22px),
      radial-gradient(120% 90% at 85% 10%, #1d1b17, #0d0d0e 60%);
    color: #f1ece2;
    font-family: 'Oswald Variable', 'Arial Narrow', sans-serif;
  }
  .ex-tramuntana .ex-tag {
    background: rgb(201 162 74 / 0.16);
    color: var(--gold);
  }
  .tr-nav {
    display: flex;
    align-items: center;
    gap: 4cqi;
    padding: 4cqi 5cqi 0;
    font-size: max(10px, 1.35cqi);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .tr-logo {
    font-size: max(14px, 2.2cqi);
    font-weight: 600;
    letter-spacing: 0.22em;
    color: var(--gold);
  }
  .tr-links {
    display: none;
    gap: 3cqi;
    margin-left: auto;
    color: #b7b0a2;
  }
  .tr-btn {
    align-self: start;
    padding: max(8px, 1.3cqi) max(16px, 2.6cqi);
    border-radius: 2px;
    background: var(--gold);
    color: #0d0d0e;
    font-size: max(12px, 1.6cqi);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .tr-btn-sm {
    display: none;
  }
  .tr-body {
    flex: 1;
    display: grid;
    align-content: center;
    gap: 6cqi;
    padding: 6cqi 5cqi;
  }
  .tr-copy {
    display: grid;
    gap: max(10px, 1.8cqi);
  }
  .tr-kick {
    margin: 0;
    color: var(--gold);
    font-size: max(11px, 1.4cqi);
    letter-spacing: 0.3em;
    text-transform: uppercase;
  }
  .tr-title {
    margin: 0;
    font-size: max(38px, 7.4cqi);
    font-weight: 600;
    line-height: 0.95;
    text-transform: uppercase;
  }
  .tr-text {
    margin: 0;
    max-width: 34ch;
    color: #b7b0a2;
    font-family: var(--text);
    font-size: max(13px, 1.55cqi);
    line-height: 1.5;
  }
  .tr-list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid rgb(201 162 74 / 0.4);
  }
  .tr-list li {
    display: flex;
    justify-content: space-between;
    padding: max(10px, 1.6cqi) 0;
    border-bottom: 1px solid rgb(201 162 74 / 0.4);
    font-size: max(14px, 1.9cqi);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .tr-list li span:last-child {
    color: var(--gold);
  }
  @container (min-width: 620px) {
    .tr-links,
    .tr-btn-sm {
      display: flex;
    }
    .tr-btn-sm {
      font-size: max(11px, 1.2cqi);
      padding: 0.8cqi 1.8cqi;
    }
    .tr-body {
      grid-template-columns: 1.3fr 1fr;
      align-items: end;
      padding-top: 4cqi;
    }
  }

  /* ---------- Centre d'estètica Alba ---------- */
  .ex-alba {
    --rose: #b5707a;
    background:
      radial-gradient(70% 80% at 85% 20%, #fbe9e6, transparent 70%),
      #f7ece9;
    color: #3d2b2e;
  }
  .ex-alba .ex-tag {
    background: rgb(181 112 122 / 0.14);
    color: #8a4652;
  }
  .al-nav {
    display: flex;
    align-items: baseline;
    gap: 4cqi;
    padding: 4cqi 5cqi 0;
  }
  .al-logo {
    font-family: 'Bodoni Moda Variable', Didot, serif;
    font-style: italic;
    font-size: max(22px, 3.2cqi);
    letter-spacing: 0.02em;
  }
  .al-links {
    display: none;
    gap: 3cqi;
    margin-left: auto;
    margin-right: 9cqi;
    color: #8a6d72;
    font-size: max(11px, 1.3cqi);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .al-body {
    flex: 1;
    display: grid;
    align-content: center;
    gap: 5cqi;
    padding: 5cqi;
  }
  .al-copy {
    display: grid;
    gap: max(10px, 1.6cqi);
    justify-items: start;
  }
  .al-title {
    margin: 0;
    font-family: 'Bodoni Moda Variable', Didot, serif;
    font-style: italic;
    font-size: max(40px, 7cqi);
    line-height: 1;
  }
  .al-text {
    margin: 0;
    color: #7a6266;
    font-size: max(13px, 1.6cqi);
  }
  .al-btn {
    padding: max(8px, 1.2cqi) max(18px, 2.8cqi);
    border-radius: 999px;
    background: #3d2b2e;
    color: #f7ece9;
    font-size: max(12px, 1.4cqi);
    letter-spacing: 0.08em;
  }
  .al-menu {
    padding: max(16px, 2.8cqi) max(18px, 3.2cqi);
    border-radius: max(10px, 1.6cqi);
    background: rgb(255 255 255 / 0.62);
    box-shadow: 0 10px 30px -18px rgb(120 70 80 / 0.4);
  }
  .al-menu-title {
    margin: 0 0 max(8px, 1.2cqi);
    color: var(--rose);
    font-size: max(11px, 1.2cqi);
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }
  .al-menu ul {
    display: grid;
    gap: max(8px, 1.3cqi);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .al-menu li {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-family: 'Bodoni Moda Variable', Didot, serif;
    font-size: max(15px, 1.95cqi);
  }
  .al-menu li i {
    flex: 1;
    border-bottom: 1px dotted rgb(181 112 122 / 0.6);
  }
  .al-menu li span:last-child {
    color: #8a6d72;
    font-family: var(--text);
    font-size: 0.8em;
  }
  @container (min-width: 620px) {
    .al-links {
      display: flex;
    }
    .al-body {
      grid-template-columns: 1fr 1.05fr;
      align-items: center;
    }
  }

  /* ---------- Massatges Serena ---------- */
  .ex-serena {
    --leaf: #4d6a46;
    background: #eef0e5;
    color: #2f3a2c;
  }
  .ex-serena .ex-tag {
    background: rgb(255 255 255 / 0.85);
    color: #3a5434;
  }
  .ex-serena .ex-inner {
    flex-direction: column;
  }
  .se-wood {
    display: grid;
    align-content: space-between;
    gap: 2cqi;
    padding: 4cqi 5cqi;
    background:
      repeating-linear-gradient(92deg, rgb(255 255 255 / 0.05) 0 1px, transparent 1px 7px),
      repeating-linear-gradient(88deg, rgb(60 35 15 / 0.12) 0 2px, transparent 2px 13px),
      linear-gradient(160deg, #a77b52, #7c5634);
    color: #f6efe3;
  }
  .se-logo {
    font-family: 'Young Serif', Georgia, serif;
    font-size: max(20px, 2.6cqi);
  }
  .se-title {
    margin: 0;
    max-width: 14ch;
    font-family: 'Young Serif', Georgia, serif;
    font-size: max(26px, 4.4cqi);
    line-height: 1.1;
  }
  .se-links {
    display: none;
    gap: 2.4cqi;
    font-size: max(11px, 1.3cqi);
    opacity: 0.85;
  }
  .se-book {
    flex: 1;
    display: grid;
    align-content: center;
    gap: max(10px, 1.6cqi);
    padding: 4cqi 5cqi;
  }
  .se-service {
    margin: 0;
    color: #66705f;
    font-size: max(12px, 1.4cqi);
  }
  .se-step {
    margin: 0;
    font-family: 'Young Serif', Georgia, serif;
    font-size: max(18px, 2.6cqi);
  }
  .se-days {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: max(6px, 1cqi);
  }
  .se-days span,
  .se-slots span {
    display: grid;
    place-items: center;
    padding: max(8px, 1.2cqi) 0;
    border-radius: max(10px, 1.2cqi);
    background: #fbfbf6;
    box-shadow: 0 0 0 1px #d9dccd inset;
    font-size: max(13px, 1.6cqi);
    font-weight: 600;
  }
  .se-days small {
    color: #56614f;
    font-size: max(10px, 0.72em);
    font-weight: 500;
    text-transform: uppercase;
  }
  .se-slots {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: max(6px, 1cqi);
  }
  .se-days .on,
  .se-slots .on {
    background: var(--leaf);
    color: #f3f5ec;
    box-shadow: none;
  }
  .se-days .on small {
    color: #eef5e8;
  }
  .se-btn {
    justify-self: start;
    padding: max(9px, 1.3cqi) max(22px, 3.4cqi);
    border-radius: 999px;
    background: var(--leaf);
    color: #f3f5ec;
    font-size: max(13px, 1.5cqi);
    font-weight: 600;
  }
  @container (min-width: 620px) {
    .ex-serena .ex-inner {
      flex-direction: row;
    }
    .se-wood {
      width: 42%;
      padding: 5cqi 4cqi;
    }
    .se-links {
      display: flex;
    }
    .se-book {
      padding: 5cqi 6cqi;
    }
  }
</style>
