---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import Demo from './Demo.astro';
import Hero from './Hero.astro';
import Marquee from './Marquee.astro';
import Island from './Island.astro';
import Compare from './Compare.astro';
import HowPhone from './HowPhone.astro';
import Examples from './Examples.astro';
import foto from '../assets/castellfollit.jpg';
import { site, whatsapp, mobilVisible, type Lang } from '../config/site';
import { dict, rutes } from '../i18n/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dict[lang];
const wa = whatsapp(lang);

---

<Hero lang={lang} />

<Marquee lang={lang} />

<!-- El problema: la trucada perduda es transforma en reserva -->
<section class="course course-lime problem">
  <div class="wrap problem-in">
    <div data-set>
      <h2 class="h2">{t.problema.titol}</h2>
      <p class="lede problem-text">{t.problema.text}</p>
    </div>
    <div data-set style="--i:1">
      <Island lang={lang} />
    </div>
  </div>
</section>

<!-- Abans / després -->
<section class="course course-lime compare-course">
  <div class="wrap">
    <h2 class="h2 head" data-set>{t.compara.titol}</h2>
    <div data-set style="--i:1">
      <Compare lang={lang} />
    </div>
  </div>
</section>

<!-- Prova-ho tu mateix -->
<section class="course course-dark" id="prova">
  <div class="wrap">
    <div class="head" data-set>
      <h2 class="h2">{t.demo.titol}</h2>
      <p class="lede">{t.demo.text}</p>
    </div>
    <Demo lang={lang} />
  </div>
</section>

<Examples lang={lang} />

<!-- Com funciona: passos a l'esquerra, mòbil en 3D a la dreta -->
<section class="course course-lime" id="com-funciona">
  <div class="wrap how">
    <div>
      <h2 class="h2 head" data-set>{t.passos.titol}</h2>
      <ol class="steps">
        {t.passos.llista.map((p, i) => (
          <li class="step" data-set style={`--i:${i}`}>
            <span class="step-n" aria-hidden="true">{i + 1}</span>
            <div>
              <h3>{p.t}</h3>
              <p>{p.d}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
    <HowPhone lang={lang} />
  </div>
</section>

<!-- Què inclou: un mur en filades -->
<section class="course course-lime">
  <div class="wrap">
    <h2 class="h2 head" data-set>{t.inclou.titol}</h2>
    <ul class="wall" data-set style="--i:1">
      {t.inclou.llista.map((f) => (
        <li class="stone">
          <h3>{f.t}</h3>
          <p>{f.d}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- Preu -->
<section class="course course-lime" id="preu">
  <div class="wrap price">
    <div class="price-figure" data-set>
      <h2 class="price-title">{t.preu.titol}</h2>
      <p class="price-num"><span data-countup={site.preu}>{site.preu}</span><span class="price-eur">€</span><span class="price-mes">{t.preu.mes}</span></p>
      <p class="price-iva">{t.preu.iva}</p>
      <p class="price-alt">{t.preu.alternativa} <strong>{site.preuUnic}&nbsp;€</strong>&nbsp;{t.preu.ivaInclos}</p>
      <ul class="price-points">
        {t.preu.punts.map((p) => (
          <li>
            <Icon name="check" />
            {p}
          </li>
        ))}
      </ul>
    </div>
    <div class="price-plaque" data-set style="--i:1">
      <p>{t.preu.destacat}</p>
      <a class="btn" href={wa} target="_blank" rel="noopener">
        <Icon name="whatsapp" />
        {t.hero.cta}
      </a>
    </div>
  </div>
</section>

<!-- Qui som -->
<section class="course course-lime">
  <div class="wrap about">
    <figure class="about-photo" data-set>
      <Image
        src={foto}
        alt={t.quisom.peuFoto}
        widths={[480, 800, 1200]}
        sizes="(min-width: 900px) 560px, 100vw"
        loading="lazy"
        format="webp"
      />
      <figcaption>
        {t.quisom.peuFoto}. {t.quisom.foto}: <a href={site.foto.url} target="_blank" rel="noopener">{site.foto.autor}</a>, Unsplash
      </figcaption>
    </figure>
    <div class="about-copy" data-set style="--i:1">
      <h2 class="h2">{t.quisom.titol}</h2>
      <p class="about-text">{t.quisom.text}</p>
      <p class="signature">{t.quisom.signatura}</p>
    </div>
  </div>
</section>

<!-- Preguntes freqüents -->
<section class="course course-lime" id="preguntes">
  <div class="wrap faq-in">
    <h2 class="h2" data-set>{t.faq.titol}</h2>
    <dl class="faq" data-set style="--i:1">
      {t.faq.llista.map((f) => (
        <div class="faq-item">
          <dt>{f.q}</dt>
          <dd>{f.a}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<!-- Contacte, amb fibres de llum al fons -->
<section class="course course-dark contact-course" id="contacte">
  <div class="fibres" data-fibres aria-hidden="true"></div>
  <div class="wrap contact">
    <div class="contact-copy" data-set>
      <h2 class="contact-title">{t.contacte.titol}</h2>
      <p class="lede">{t.contacte.text}</p>
      <p class="contact-legal"><a href={rutes[lang].privacitat}>{t.peu.privacitat}</a></p>
    </div>
    <div class="contact-wall" data-set style="--i:1">
      <div class="contact-stone">
        <p class="contact-label">WhatsApp</p>
        <p class="contact-value">{mobilVisible()}</p>
        <a class="btn btn-big" href={wa} target="_blank" rel="noopener">
          <Icon name="whatsapp" />
          <span>{t.hero.cta}</span>
        </a>
      </div>
      <div class="contact-stone">
        <p class="contact-label">{t.contacte.correu}</p>
        <a class="contact-mail" href={`mailto:${site.correu}`}>{site.correu}</a>
      </div>
    </div>
  </div>
</section>

<script>
  const reduceMq = window.matchMedia('(prefers-reduced-motion: reduce)');

  // ---- Fibres de llum: el canvas només es crea quan el contacte s'acosta ----
  const fibres = document.querySelector<HTMLElement>('[data-fibres]');
  if (fibres) {
    const fio = new IntersectionObserver(
      ([e]) => {
        if (!e.isIntersecting) return;
        fio.disconnect();
        import('../scripts/fibres').then(({ mountFibres }) => mountFibres(fibres));
      },
      { rootMargin: '400px 0px' },
    );
    fio.observe(fibres);
  }

</script>

<style>
  .head {
    display: grid;
    gap: 18px;
    max-width: 44rem;
    margin-bottom: clamp(40px, 6vw, 72px);
  }


  /* ---------- Problema ---------- */
  .problem-in {
    display: grid;
    gap: 48px;
    align-items: center;
  }
  .problem .h2 {
    max-width: 19ch;
  }
  .problem-text {
    margin-top: 22px;
  }
  @media (min-width: 900px) {
    .problem-in {
      grid-template-columns: 1.2fr 1fr;
      gap: 80px;
    }
  }


  /* ---------- Abans / després ---------- */
  .compare-course .h2 {
    max-width: 22ch;
  }

  /* ---------- Com funciona ---------- */
  .how {
    display: grid;
    gap: 48px;
    align-items: center;
  }
  .steps {
    display: grid;
    gap: 3px;
    margin: 0;
    padding: 3px;
    list-style: none;
    background: var(--joint-lime);
  }
  .step {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 20px;
    align-items: start;
    padding: clamp(22px, 3vw, 32px) clamp(20px, 3vw, 30px);
    background: var(--face);
  }
  .step-n {
    font-family: var(--display);
    font-size: clamp(2.75rem, 5vw, 3.75rem);
    line-height: 0.9;
    color: var(--lichen-ink);
    min-width: 1ch;
  }
  .step h3 {
    font-size: 1.3125rem;
  }
  .step p {
    margin-top: 6px;
    color: var(--ink-muted);
  }
  @media (min-width: 900px) {
    .how {
      grid-template-columns: 1.15fr 1fr;
      gap: 64px;
    }
  }

  /* ---------- Què inclou: mur de pedres a trencajunts ---------- */
  .wall {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 3px;
    margin: 0;
    padding: 3px;
    list-style: none;
    background: var(--bed);
    border-radius: 4px;
  }
  .stone {
    grid-column: span 12;
    display: grid;
    gap: 8px;
    align-content: start;
    padding: clamp(24px, 3.4vw, 40px);
    background:
      linear-gradient(rgb(36 40 44 / 0.72), rgb(36 40 44 / 0.72)),
      url('/img/basalt.webp') var(--bx, 50%) var(--by, 50%) / 260% no-repeat;
    border-radius: 2px;
  }
  .stone:nth-child(1) { --bx: 8%; --by: 12%; }
  .stone:nth-child(2) { --bx: 70%; --by: 20%; }
  .stone:nth-child(3) { --bx: 30%; --by: 55%; }
  .stone:nth-child(4) { --bx: 85%; --by: 64%; }
  .stone:nth-child(5) { --bx: 18%; --by: 90%; }
  .stone:nth-child(6) { --bx: 60%; --by: 82%; }
  .stone {
    color: #f2f1ed;
  }
  .stone h3 {
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(1.375rem, 2.2vw, 1.75rem);
    line-height: 1.15;
  }
  .stone p {
    color: var(--mist-2);
    max-width: 36ch;
  }
  @media (min-width: 720px) {
    .stone:nth-child(4n + 1),
    .stone:nth-child(4n + 4) {
      grid-column: span 7;
    }
    .stone:nth-child(4n + 2),
    .stone:nth-child(4n + 3) {
      grid-column: span 5;
    }
  }

  /* ---------- Preu ---------- */
  .price {
    display: grid;
    gap: 48px;
    align-items: center;
  }
  .price-title {
    font-size: clamp(1.75rem, 3.4vw, 2.5rem);
  }
  .price-num {
    margin-top: 10px;
    font-family: var(--display);
    font-size: clamp(5rem, 15vw, 6rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
  }
  .price-eur {
    margin-left: 0.08em;
    font-size: 0.5em;
    vertical-align: 0.6em;
  }
  .price-mes {
    margin-left: 0.06em;
    font-size: 0.32em;
    letter-spacing: 0;
    color: var(--ink-muted);
  }
  .price-alt {
    margin-top: 10px;
    color: var(--ink-muted);
  }
  .price-alt strong {
    color: var(--ink);
  }
  .price-iva {
    margin-top: 6px;
    color: var(--ink-muted);
    font-weight: 600;
  }
  .price-points {
    display: grid;
    gap: 10px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
    font-weight: 600;
  }
  .price-points li {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .price-points :global(svg) {
    width: 20px;
    height: 20px;
    color: var(--lichen-ink);
  }
  .price-plaque {
    display: grid;
    gap: 28px;
    padding: clamp(28px, 4.5vw, 52px);
    border-radius: 4px;
    background:
      linear-gradient(rgb(19 21 23 / 0.88), rgb(19 21 23 / 0.88)),
      url('/img/basalt.webp') 40% 30% / cover no-repeat;
    color: #f2f1ed;
    box-shadow: 0 0 0 2px var(--lime-bed);
  }
  .price-plaque p {
    font-family: var(--display);
    font-size: clamp(1.625rem, 3.2vw, 2.375rem);
    line-height: 1.18;
    text-wrap: balance;
  }
  .price-plaque .btn {
    justify-self: start;
  }
  @media (min-width: 900px) {
    .price {
      grid-template-columns: 1fr 1.25fr;
      gap: 80px;
    }
  }

  /* ---------- Qui som ---------- */
  .about {
    display: grid;
    gap: 44px;
    align-items: center;
  }
  .about-photo {
    margin: 0;
  }
  .about-photo :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 38% center;
    border-radius: 4px;
    filter: saturate(0.82) contrast(1.04);
  }
  .about-photo figcaption {
    margin-top: 12px;
    color: var(--ink-muted);
    font-size: 0.8125rem;
  }
  .about-copy {
    display: grid;
    gap: 24px;
  }
  .about-text {
    font-size: clamp(1.125rem, 2vw, 1.3125rem);
    line-height: 1.6;
    color: var(--ink-muted);
    max-width: 36rem;
  }
  .signature {
    padding-top: 20px;
    border-top: 3px solid var(--joint-lime);
    font-family: var(--display);
    font-size: 1.25rem;
  }
  @media (min-width: 900px) {
    .about {
      grid-template-columns: 0.9fr 1.1fr;
      gap: 88px;
    }
  }

  /* ---------- Preguntes: obertes, sense desplegables ---------- */
  .faq-in {
    display: grid;
    gap: 40px;
  }
  .faq {
    display: grid;
    gap: 3px;
    margin: 0;
    padding: 3px;
    background: var(--joint-lime);
  }
  .faq-item {
    display: grid;
    gap: 10px;
    align-content: start;
    padding: clamp(22px, 3vw, 32px);
    background: var(--face);
  }
  .faq dt {
    font-size: 1.1875rem;
    font-weight: 650;
    line-height: 1.3;
  }
  .faq dd {
    margin: 0;
    max-width: 60ch;
    color: var(--ink-muted);
  }
  @media (min-width: 760px) {
    .faq {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 1040px) {
    .faq-in {
      grid-template-columns: 1fr 2.4fr;
      gap: 64px;
      align-items: start;
    }
  }

  /* ---------- Contacte ---------- */
  .contact {
    display: grid;
    gap: 44px;
    align-items: end;
  }
  .contact-copy {
    display: grid;
    justify-items: start;
    gap: 22px;
  }
  .contact-title {
    font-size: clamp(2.75rem, 8vw, 5.5rem);
    max-width: 12ch;
  }
  .contact-legal {
    margin-top: 8px;
    font-size: 0.875rem;
  }
  .contact-legal a {
    display: inline-block;
    padding-block: 12px;
    color: var(--mist);
  }
  .contact-wall {
    display: grid;
    gap: 3px;
    padding: 3px;
    background: var(--bed);
    border-radius: 4px;
  }
  .contact-stone {
    display: grid;
    justify-items: start;
    gap: 6px;
    padding: clamp(24px, 3.4vw, 40px);
    background:
      linear-gradient(rgb(36 40 44 / 0.72), rgb(36 40 44 / 0.72)),
      url('/img/basalt.webp') 20% 30% / 220% no-repeat;
    border-radius: 2px;
  }
  .contact-stone + .contact-stone {
    background-position: 0 0, 80% 75%;
  }
  .contact-label {
    color: var(--mist);
    font-size: 0.9375rem;
    font-weight: 600;
  }
  .contact-value {
    font-family: var(--display);
    font-size: clamp(2rem, 4vw, 2.75rem);
    line-height: 1.1;
  }
  .contact-stone .btn {
    margin-top: 18px;
  }
  .btn-big {
    min-height: 60px;
    padding: 0 26px;
    font-size: 1.0625rem;
  }
  .contact-mail {
    font-family: var(--display);
    font-size: clamp(1.375rem, 3vw, 1.75rem);
    color: var(--chalk);
    word-break: break-word;
  }
  @media (min-width: 900px) {
    .contact {
      grid-template-columns: 1.1fr 1fr;

  /* Fibres de llum darrere el contacte */
  .contact-course {
    overflow: hidden;
  }
  .fibres {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 35%, #000 80%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 35%, #000 80%, transparent);
  }
  .fibres :global(canvas) {
    width: 100%;
    height: 100%;
    display: block;
  }
  .contact {
    position: relative;
    z-index: 1;
  }
</style>
