---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import Demo from './Demo.astro';
import foto from '../assets/castellfollit.jpg';
import { site, whatsapp, mobilVisible, type Lang } from '../config/site';
import { dict, exemples, rutes } from '../i18n/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dict[lang];
const wa = whatsapp(lang);

const captures = import.meta.glob<{ default: ImageMetadata }>('../assets/exemples/*.webp', { eager: true });
const captura = (id: string) => captures[`../assets/exemples/${id}.webp`]?.default;
const heroShot = captura('celbellesa-reserva')!;

const trucades = ['09:12', '10:47', '12:05', '17:38'];
---

<!-- Portada -->
<section class="course course-dark hero" data-hero>
  <div class="hero-field" data-field aria-hidden="true">
    <img class="hero-field-still" src="/img/camp-basalt.webp" alt="" width="1600" height="561" loading="lazy" decoding="async" />
  </div>
  <script is:inline>
    (function () {
      var f = document.currentScript.previousElementSibling;
      var mq = function (q) { return window.matchMedia(q).matches; };
      var c = navigator.connection || {};
      var ok = mq('(hover: hover) and (pointer: fine)') && !mq('(prefers-reduced-motion: reduce)') &&
        !c.saveData && (navigator.hardwareConcurrency || 4) >= 4 && !!window.WebGLRenderingContext;
      if (/[?&]camp=(3d|still)/.test(location.search)) ok = true;
      f.dataset.mode = ok ? '3d' : 'still';
    })();
  </script>
  <div class="wrap hero-in">
    <div class="hero-copy">
      <h1 class="rise" style="--i:0">{t.hero.titol}</h1>
      <p class="lede rise" style="--i:1">{t.hero.subtitol}</p>
      <div class="hero-actions rise" style="--i:2">
        <a class="btn" href={wa} target="_blank" rel="noopener">
          <Icon name="whatsapp" />
          {t.hero.cta}
        </a>
        <a class="link-arrow hero-link" href="#exemples">
          {t.hero.secundari}
          <Icon name="arrow" />
        </a>
      </div>
    </div>

    <div class="plaque rise" style="--i:1">
      <div class="plaque-device">
        <Image src={heroShot} alt={t.hero.peuMobil} widths={[320, 640]} sizes="320px" loading="eager" fetchpriority="high" />
      </div>
    </div>
  </div>
</section>

<!-- El problema -->
<section class="course course-lime problem">
  <div class="wrap problem-in">
    <div data-set>
      <h2 class="h2">{t.problema.titol}</h2>
      <p class="lede problem-text">{t.problema.text}</p>
    </div>
    <div class="ledger" data-set style="--i:1">
      <p class="ledger-head">
        <span>{t.problema.trucades}</span>
        <strong>{trucades.length}</strong>
      </p>
      <ol>
        {trucades.map((h) => (
          <li>
            <Icon name="phone-x" />
            <time>{h}</time>
            <span>{t.problema.perduda}</span>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<!-- Prova-ho tu mateix -->
<section class="course course-dark" id="prova">
  <div class="wrap">
    <div class="head" data-set>
      <h2 class="h2">{t.demo.titol}</h2>
      <p class="lede">{t.demo.text}</p>
    </div>
    <Demo lang={lang} />
  </div>
</section>

<!-- Exemples -->
<section class="course course-lime" id="exemples">
  <div class="wrap">
    <div class="head" data-set>
      <h2 class="h2">{t.exemples.titol}</h2>
      <p class="lede">{t.exemples.text}</p>
    </div>
    <ul class="works">
      {exemples.map((e, i) => {
        const img = captura(e.id);
        return (
          <li class="work" data-set style={`--i:${i % 3}`}>
            <div class="work-device" data-tilt>
              {e.enLinia && img ? (
                <Image src={img} alt={`${t.exemples.alt} ${e.nom}`} widths={[260, 420, 560]} sizes="(min-width: 960px) 280px, min(68vw, 260px)" loading="lazy" />
              ) : (
                <span class="work-soon" aria-hidden="true">{e.nom}</span>
              )}
            </div>
            <div class="work-meta">
              <h3>{e.nom}</h3>
              <p>{e.tipus[lang]} · {e.lloc}</p>
              {e.enLinia ? (
                <a class="link-arrow" href={e.url} target="_blank" rel="noopener">
                  {t.exemples.veure}<span class="sr-only">: {e.nom}</span>
                  <Icon name="arrow" />
                </a>
              ) : (
                <span class="work-badge">{t.exemples.aviat}</span>
              )}
            </div>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<!-- Com funciona -->
<section class="course course-lime" id="com-funciona">
  <div class="wrap">
    <h2 class="h2 head" data-set>{t.passos.titol}</h2>
    <ol class="steps">
      {t.passos.llista.map((p, i) => (
        <li class="step" data-set style={`--i:${i}`}>
          <span class="step-n" aria-hidden="true">{i + 1}</span>
          <h3>{p.t}</h3>
          <p>{p.d}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- Què inclou: un mur en filades -->
<section class="course course-lime">
  <div class="wrap">
    <h2 class="h2 head" data-set>{t.inclou.titol}</h2>
    <ul class="wall" data-set style="--i:1">
      {t.inclou.llista.map((f) => (
        <li class="stone">
          <h3>{f.t}</h3>
          <p>{f.d}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- Preu -->
<section class="course course-lime" id="preu">
  <div class="wrap price">
    <div class="price-figure" data-set>
      <h2 class="price-title">{t.preu.titol}</h2>
      <p class="price-num"><span data-count={site.preu}>{site.preu}</span><span class="price-eur">€</span></p>
      <p class="price-iva">{t.preu.iva}</p>
      <dl class="price-facts">
        {t.preu.xifres.map((x) => (
          <div>
            <dt><span data-count={x.valor}>{x.valor}</span> {x.unitat}</dt>
            <dd>{x.text}</dd>
          </div>
        ))}
      </dl>
      <ul class="price-points">
        {t.preu.punts.map((p) => (
          <li>
            <Icon name="check" />
            {p}
          </li>
        ))}
      </ul>
    </div>
    <div class="price-plaque" data-set style="--i:1">
      <p>{t.preu.destacat}</p>
      <a class="btn" href={wa} target="_blank" rel="noopener">
        <Icon name="whatsapp" />
        {t.hero.cta}
      </a>
    </div>
  </div>
</section>

<!-- Qui som -->
<section class="course course-lime">
  <div class="wrap about">
    <figure class="about-photo" data-set>
      <Image
        src={foto}
        alt={t.quisom.peuFoto}
        widths={[480, 800, 1200]}
        sizes="(min-width: 900px) 560px, 100vw"
        loading="lazy"
        format="webp"
      />
      <figcaption>
        {t.quisom.peuFoto}. {t.quisom.foto}: <a href={site.foto.url} target="_blank" rel="noopener">{site.foto.autor}</a>, Unsplash
      </figcaption>
    </figure>
    <div class="about-copy" data-set style="--i:1">
      <h2 class="h2">{t.quisom.titol}</h2>
      <p class="about-text">{t.quisom.text}</p>
      <p class="signature">{t.quisom.signatura}</p>
    </div>
  </div>
</section>

<!-- Preguntes freqüents -->
<section class="course course-lime" id="preguntes">
  <div class="wrap faq-in">
    <h2 class="h2" data-set>{t.faq.titol}</h2>
    <dl class="faq" data-set style="--i:1">
      {t.faq.llista.map((f) => (
        <div class="faq-item">
          <dt>{f.q}</dt>
          <dd>{f.a}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<!-- Contacte -->
<section class="course course-dark" id="contacte">
  <div class="wrap contact">
    <div class="contact-copy" data-set>
      <h2 class="contact-title">{t.contacte.titol}</h2>
      <p class="lede">{t.contacte.text}</p>
      <p class="contact-legal"><a href={rutes[lang].privacitat}>{t.peu.privacitat}</a></p>
    </div>
    <div class="contact-wall" data-set style="--i:1">
      <div class="contact-stone">
        <p class="contact-label">WhatsApp</p>
        <p class="contact-value">{mobilVisible()}</p>
        <a class="btn btn-big" href={wa} target="_blank" rel="noopener">
          <Icon name="whatsapp" />
          <span>{t.hero.cta}</span>
        </a>
      </div>
      <div class="contact-stone">
        <p class="contact-label">{t.contacte.correu}</p>
        <a class="contact-mail" href={`mailto:${site.correu}`}>{site.correu}</a>
      </div>
    </div>
  </div>
</section>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  // ---- Columnes de basalt: three.js només quan el navegador està lliure ----
  const field = document.querySelector<HTMLElement>('[data-field]');
  if (field?.dataset.mode === '3d') {
    const still = /[?&]camp=still/.test(location.search);
    const start = () =>
      import('../scripts/basalt-field')
        .then(({ mountBasaltField }) => {
          const { canvas } = mountBasaltField(field, { still });
          requestAnimationFrame(() => canvas.classList.add('is-ready'));
          field.dataset.ready = '';
        })
        .catch(() => (field.dataset.mode = 'still'));
    const idle = () => ('requestIdleCallback' in window ? requestIdleCallback(start, { timeout: 2500 }) : setTimeout(start, 600));
    if (document.readyState === 'complete') idle();
    else window.addEventListener('load', idle, { once: true });
  }

  // ---- Xifres que compten fins al seu valor quan apareixen ----
  const counters = document.querySelectorAll<HTMLElement>('[data-count]');
  const countUp = (el: HTMLElement) => {
    const to = Number(el.dataset.count);
    if (!to || reduce.matches) return;
    el.style.minWidth = el.offsetWidth + 'px';
    const t0 = performance.now();
    const dur = 1100;
    const tick = (now: number) => {
      const p = Math.min(1, (now - t0) / dur);
      el.textContent = String(Math.round(to * (1 - Math.pow(1 - p, 4))));
      if (p < 1) requestAnimationFrame(tick);
    };
    el.textContent = '0';
    requestAnimationFrame(tick);
  };
  const cio = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          countUp(e.target as HTMLElement);
          cio.unobserve(e.target);
        }
      }
    },
    { threshold: 0.6 },
  );
  counters.forEach((el) => cio.observe(el));

  // ---- Mòbils dels exemples: inclinació 3D seguint el ratolí ----
  if (window.matchMedia('(hover: hover) and (pointer: fine)').matches && !reduce.matches) {
    document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((el) => {
      let tx = 0, ty = 0, x = 0, y = 0, raf = 0;
      const loop = () => {
        x += (tx - x) * 0.14;
        y += (ty - y) * 0.14;
        el.style.transform = `perspective(900px) rotateX(${y.toFixed(2)}deg) rotateY(${x.toFixed(2)}deg)`;
        raf = Math.abs(tx - x) > 0.01 || Math.abs(ty - y) > 0.01 ? requestAnimationFrame(loop) : 0;
        if (!raf && tx === 0 && ty === 0) el.style.transform = '';
      };
      const go = () => { if (!raf) raf = requestAnimationFrame(loop); };
      el.addEventListener('pointermove', (e) => {
        const r = el.getBoundingClientRect();
        tx = ((e.clientX - r.left) / r.width - 0.5) * 10;
        ty = -((e.clientY - r.top) / r.height - 0.5) * 8;
        go();
      });
      el.addEventListener('pointerleave', () => { tx = 0; ty = 0; go(); });
    });
  }
</script>

<style>
  .head {
    display: grid;
    gap: 18px;
    max-width: 44rem;
    margin-bottom: clamp(40px, 6vw, 72px);
  }

  /* ---------- Portada ---------- */
  .hero {
    padding-block: clamp(48px, 7vw, 96px) 0;
    overflow: hidden;
  }
  .hero-in {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 48px;
    align-items: end;
  }

  /* Camp de columnes de basalt: darrere el contingut, esvaït cap amunt */
  .hero-field {
    position: absolute;
    inset: auto 0 0 0;
    height: min(78%, 680px);
    z-index: 0;
    pointer-events: none;
    /* Esvaït cap amunt i cap a l'esquerra, perquè el text quedi net */
    -webkit-mask-image: linear-gradient(to top, #000 50%, transparent), linear-gradient(to right, transparent 8%, #000 60%);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(to top, #000 50%, transparent), linear-gradient(to right, transparent 8%, #000 60%);
    mask-composite: intersect;
  }
  .hero-field img,
  .hero-field :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% 100%;
  }
  .hero-field[data-mode='3d'] img {
    display: none;
  }
  .hero-field :global(canvas) {
    opacity: 0;
    transition: opacity 900ms var(--ease-out);
  }
  .hero-field :global(canvas.is-ready) {
    opacity: 1;
  }
  .hero-copy {
    display: grid;
    gap: 26px;
    padding-bottom: 8px;
  }
  .hero h1 {
    font-size: clamp(2.5rem, 5vw, 3.75rem);
    line-height: 1.04;
    max-width: 22ch;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 28px;
    margin-top: 6px;
  }
  .hero-actions .btn {
    flex: 1 1 100%;
  }
  .hero-link {
    color: var(--chalk);
  }
  @media (min-width: 520px) {
    .hero-actions .btn {
      flex: 0 0 auto;
    }
  }

  .rise {
    animation: rise 900ms var(--ease-out) both;
    animation-delay: calc(60ms + var(--i, 0) * 90ms);
  }
  h1.rise {
    animation-name: settle-in;
    animation-delay: 0ms;
  }
  @keyframes settle-in {
    from {
      transform: translateY(10px);
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  /* El mòbil encastat a la paret: la filada el talla per sota */
  .plaque {
    justify-self: center;
    width: min(300px, 76vw);
    margin-bottom: -64px;
  }
  .plaque-device {
    padding: 9px;
    border-radius: 42px;
    background: var(--device);
    box-shadow:
      0 0 0 1px var(--slate-2) inset,
      0 40px 80px -30px rgb(0 0 0 / 0.75);
  }
  .plaque-device :global(img) {
    width: 100%;
    height: auto;
    border-radius: 33px;
  }
  @media (min-width: 900px) {
    .hero-in {
      grid-template-columns: 1.6fr 1fr;
      gap: 40px;
    }
    .hero-copy {
      padding-bottom: clamp(88px, 10vw, 136px);
    }
    .plaque {
      width: 320px;
      margin-bottom: -120px;
    }
  }

  /* ---------- Problema ---------- */
  .problem-in {
    display: grid;
    gap: 48px;
    align-items: center;
  }
  .problem .h2 {
    max-width: 19ch;
  }
  .problem-text {
    margin-top: 22px;
  }
  .ledger {
    width: 100%;
    max-width: 440px;
    justify-self: center;
    padding: 3px;
    background: var(--joint-lime);
  }
  .ledger-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 16px 20px;
    background: var(--face);
    font-weight: 650;
  }
  .ledger-head strong {
    font-family: var(--display);
    font-size: 1.75rem;
    font-weight: 400;
    line-height: 1;
    color: var(--missed);
  }
  .ledger ol {
    display: grid;
    gap: 3px;
    margin: 3px 0 0;
    padding: 0;
    list-style: none;
  }
  .ledger li {
    display: grid;
    grid-template-columns: 20px 3.5rem 1fr;
    align-items: center;
    gap: 14px;
    padding: 14px 20px;
    background: var(--face);
  }
  .ledger :global(svg) {
    width: 18px;
    height: 18px;
    color: var(--missed);
  }
  .ledger time {
    font-family: var(--display);
    font-size: 1.1875rem;
    font-variant-numeric: tabular-nums;
  }
  .ledger li span {
    color: var(--ink-muted);
    font-size: 0.9375rem;
  }
  @media (min-width: 900px) {
    .problem-in {
      grid-template-columns: 1.2fr 1fr;
      gap: 80px;
    }
  }

  /* ---------- Exemples ---------- */
  .works {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(68vw, 260px);
    gap: 20px;
    margin: 0 calc(var(--gutter) * -1);
    padding: 8px var(--gutter) 24px;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    overscroll-behavior-x: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--lime-bed) transparent;
  }
  .work {
    scroll-snap-align: start;
    display: grid;
    gap: 18px;
    align-content: start;
  }
  .work-device {
    transform-style: preserve-3d;
    aspect-ratio: 9 / 16;
    padding: 7px;
    border-radius: 34px;
    background: var(--device);
    box-shadow: 0 24px 40px -26px rgb(22 24 26 / 0.6);
    overflow: hidden;
  }
  .work-device :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    border-radius: 27px;
  }
  .work-soon {
    display: grid;
    place-items: center;
    height: 100%;
    border-radius: 27px;
    background: var(--slate-2);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.1);
    padding: 0 18px;
    color: #f2f1ed;
    font-family: var(--display);
    font-size: 1.625rem;
    text-align: center;
    line-height: 1.1;
  }
  .work-meta {
    display: grid;
    gap: 4px;
    padding-left: 6px;
  }
  .work-meta h3 {
    font-family: var(--display);
    font-weight: 400;
    font-size: 1.5rem;
  }
  .work-meta p {
    color: var(--ink-muted);
  }
  .work-meta .link-arrow {
    justify-self: start;
    margin-top: 6px;
    padding-block: 6px;
    color: var(--lichen-ink);
  }
  .work-badge {
    justify-self: start;
    margin-top: 10px;
    padding: 4px 10px;
    background: var(--face);
    box-shadow: inset 0 0 0 2px var(--joint-lime);
    color: var(--ink-muted);
    font-size: 0.8125rem;
    font-weight: 650;
  }
  @media (min-width: 960px) {
    .works {
      grid-auto-flow: row;
      grid-template-columns: repeat(3, 1fr);
      gap: 56px clamp(32px, 4vw, 64px);
      margin: 0;
      padding: 0;
      overflow: visible;
    }
    /* Trencajunts: la columna central baixa mitja pedra */
    .work:nth-child(3n + 2) {
      margin-top: 64px;
    }
    .work:nth-child(3n + 2) + .work {
      margin-top: 0;
    }
    .work-device {
      max-width: 300px;
    }
  }

  /* ---------- Com funciona ---------- */
  .steps {
    display: grid;
    gap: 3px;
    margin: 0;
    padding: 3px;
    list-style: none;
    background: var(--joint-lime);
  }
  .step {
    display: grid;
    gap: 10px;
    align-content: start;
    padding: clamp(28px, 4vw, 44px) clamp(22px, 3vw, 36px);
    background: var(--face);
  }
  .step-n {
    font-family: var(--display);
    font-size: clamp(3rem, 6vw, 4.5rem);
    line-height: 0.9;
    color: var(--lichen-ink);
  }
  .step h3 {
    margin-top: 14px;
    font-size: 1.3125rem;
  }
  .step p {
    color: var(--ink-muted);
  }
  @media (min-width: 820px) {
    /* Trencajunts: la pedra del mig és més ampla i desplaça els junts */
    .steps {
      grid-template-columns: 4fr 5fr 4fr;
    }
  }

  /* ---------- Què inclou: mur de pedres a trencajunts ---------- */
  .wall {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 3px;
    margin: 0;
    padding: 3px;
    list-style: none;
    background: var(--bed);
    border-radius: 4px;
  }
  .stone {
    grid-column: span 12;
    display: grid;
    gap: 8px;
    align-content: start;
    padding: clamp(24px, 3.4vw, 40px);
    background:
      linear-gradient(rgb(36 40 44 / 0.72), rgb(36 40 44 / 0.72)),
      url('/img/basalt.webp') var(--bx, 50%) var(--by, 50%) / 260% no-repeat;
    border-radius: 2px;
  }
  .stone:nth-child(1) { --bx: 8%; --by: 12%; }
  .stone:nth-child(2) { --bx: 70%; --by: 20%; }
  .stone:nth-child(3) { --bx: 30%; --by: 55%; }
  .stone:nth-child(4) { --bx: 85%; --by: 64%; }
  .stone:nth-child(5) { --bx: 18%; --by: 90%; }
  .stone:nth-child(6) { --bx: 60%; --by: 82%; }
  .stone {
    color: #f2f1ed;
  }
  .stone h3 {
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(1.375rem, 2.2vw, 1.75rem);
    line-height: 1.15;
  }
  .stone p {
    color: var(--mist-2);
    max-width: 36ch;
  }
  @media (min-width: 720px) {
    .stone:nth-child(4n + 1),
    .stone:nth-child(4n + 4) {
      grid-column: span 7;
    }
