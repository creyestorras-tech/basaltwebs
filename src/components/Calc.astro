---
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import { plans, whatsapp, type Lang } from '../config/site';
import { rutes } from '../i18n/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const r = rutes[lang];
const pla = plans.find((p) => p.id === 'allotjament')!;
const IVA = 0.21;
const costAny = Math.round(pla.mes * 12 * (1 + IVA) * 100) / 100;

const tx = {
  ca: {
    title: 'Calculadora de comissions de Booking i Airbnb per a cases rurals | Basalt Webs',
    description:
      "Calcula quant pagues cada any en comissions a Booking o Airbnb i quant t'estalviaries amb reserves directes des d'una web pròpia.",
    h1: 'Quant et costen les comissions de Booking i Airbnb?',
    lede: "Posa-hi els números de la teva casa i mira quant pagues cada any en comissions, i quant t'estalviaries si una part dels clients reservés directament amb tu.",
    preu: 'Preu mitjà per nit',
    nits: 'Nits reservades per plataformes en un any',
    pct: 'Comissió de la plataforma',
    pctAjuda: 'A Booking sol ser al voltant d’un 15 %, però depèn del teu contracte.',
    directe: 'Part dels clients que podrien reservar directament',
    directeAjuda: 'Clients que repeteixen, que et coneixen o que busquen el nom de la casa a Google.',
    resultat: 'El resultat',
    comissions: 'Pagues en comissions cada any',
    estalvi: 'Comissions que t’estalviaries',
    web: 'Cost de la web en un any',
    webDetall: `${pla.mes} €/mes + IVA`,
    net: 'Et quedaria a la butxaca',
    perdua: 'Amb aquests números, encara no et compensa',
    nitsMin: 'nits directes l’any i la web ja està pagada',
    nota: 'Càlcul orientatiu. La comissió real depèn de la plataforma i de les condicions de la teva casa. No inclou la taxa turística ni l’IVA de la comissió.',
    cta: 'Demana la proposta per a la teva casa',
    wa: 'Parlem per WhatsApp',
    demo: 'Mira una casa rural de demostració',
    nit: '€',
    any: 'nits',
  },
  es: {
    title: 'Calculadora de comisiones de Booking y Airbnb para casas rurales | Basalt Webs',
    description:
      'Calcula cuánto pagas cada año en comisiones a Booking o Airbnb y cuánto ahorrarías con reservas directas desde una web propia.',
    h1: '¿Cuánto te cuestan las comisiones de Booking y Airbnb?',
    lede: 'Pon los números de tu casa y mira cuánto pagas cada año en comisiones, y cuánto ahorrarías si una parte de los clientes reservara directamente contigo.',
    preu: 'Precio medio por noche',
    nits: 'Noches reservadas por plataformas en un año',
    pct: 'Comisión de la plataforma',
    pctAjuda: 'En Booking suele rondar el 15 %, pero depende de tu contrato.',
    directe: 'Parte de los clientes que podrían reservar directamente',
    directeAjuda: 'Clientes que repiten, que te conocen o que buscan el nombre de la casa en Google.',
    resultat: 'El resultado',
    comissions: 'Pagas en comisiones cada año',
    estalvi: 'Comisiones que te ahorrarías',
    web: 'Coste de la web en un año',
    webDetall: `${pla.mes} €/mes + IVA`,
    net: 'Te quedaría en el bolsillo',
    perdua: 'Con estos números, todavía no te compensa',
    nitsMin: 'noches directas al año y la web ya está pagada',
    nota: 'Cálculo orientativo. La comisión real depende de la plataforma y de las condiciones de tu casa. No incluye la tasa turística ni el IVA de la comisión.',
    cta: 'Pide la propuesta para tu casa',
    wa: 'Hablemos por WhatsApp',
    demo: 'Mira una casa rural de demostración',
    nit: '€',
    any: 'noches',
  },
}[lang];

const def = { preu: 180, nits: 80, pct: 15, directe: 30 };
const fmt = (n: number) =>
  new Intl.NumberFormat(lang === 'ca' ? 'ca-ES' : 'es-ES', { maximumFractionDigits: 0 }).format(Math.round(n)) + ' €';
const calc = (v: typeof def) => {
  const comissions = v.preu * v.nits * (v.pct / 100);
  const estalvi = comissions * (v.directe / 100);
  const net = estalvi - costAny;
  const perNit = v.preu * (v.pct / 100);
  const nitsMin = perNit > 0 ? Math.ceil(costAny / perNit) : 0;
  return { comissions, estalvi, net, nitsMin };
};
const ini = calc(def);
const demoUrl = lang === 'ca' ? 'https://demorural.pages.dev/ca/' : 'https://demorural.pages.dev/es/';
const alt = { ca: rutes.ca.calculadora, es: rutes.es.calculadora };
---
<Base lang={lang} title={tx.title} description={tx.description} alt={alt}>
  <section class="course course-dark calc-hero">
    <div class="wrap">
      <h1 class="calc-title">{tx.h1}</h1>
      <p class="lede calc-lede">{tx.lede}</p>
    </div>
  </section>

  <section class="course course-lime calc-course">
    <div class="wrap calc">
      <form class="calc-form" data-calc onsubmit="return false">
        <label class="field">
          <span class="field-top"><span>{tx.preu}</span><output data-out="preu">{def.preu} €</output></span>
          <input type="range" name="preu" min="40" max="900" step="10" value={def.preu} />
        </label>
        <label class="field">
          <span class="field-top"><span>{tx.nits}</span><output data-out="nits">{def.nits} {tx.any}</output></span>
          <input type="range" name="nits" min="5" max="300" step="5" value={def.nits} />
        </label>
        <label class="field">
          <span class="field-top"><span>{tx.pct}</span><output data-out="pct">{def.pct} %</output></span>
          <input type="range" name="pct" min="3" max="25" step="1" value={def.pct} />
          <small>{tx.pctAjuda}</small>
        </label>
        <label class="field">
          <span class="field-top"><span>{tx.directe}</span><output data-out="directe">{def.directe} %</output></span>
          <input type="range" name="directe" min="0" max="100" step="5" value={def.directe} />
          <small>{tx.directeAjuda}</small>
        </label>
      </form>

      <div class="result" aria-live="polite">
        <p class="result-head">{tx.resultat}</p>
        <dl class="rows">
          <div class="row">
            <dt>{tx.comissions}</dt>
            <dd data-r="comissions">{fmt(ini.comissions)}</dd>
          </div>
          <div class="row">
            <dt>{tx.estalvi}</dt>
            <dd data-r="estalvi">{fmt(ini.estalvi)}</dd>
          </div>
          <div class="row">
            <dt>{tx.web} <small>{tx.webDetall}</small></dt>
            <dd>− {fmt(costAny)}</dd>
          </div>
          <div class="row row-total" data-total>
            <dt data-r="netLabel">{ini.net >= 0 ? tx.net : tx.perdua}</dt>
            <dd data-r="net">{fmt(ini.net)}</dd>
          </div>
        </dl>
        <p class="breakeven"><strong data-r="nitsMin">{ini.nitsMin}</strong> {tx.nitsMin}</p>
        <div class="result-actions">
          <a class="btn" href={`${r.proposta}?negoci=allotjament`}>{tx.cta}</a>
          <a class="link-arrow" href={demoUrl} target="_blank" rel="noopener">{tx.demo} <Icon name="arrow" /></a>
        </div>
        <p class="note">{tx.nota}</p>
      </div>
    </div>
  </section>

  <script
    type="application/json"
    id="calc-cfg"
    set:html={JSON.stringify({
      costAny,
      locale: lang === 'ca' ? 'ca-ES' : 'es-ES',
      net: tx.net,
      perdua: tx.perdua,
      any: tx.any,
    })}
  />
</Base>

<script>
  const cfg = JSON.parse(document.getElementById('calc-cfg')!.textContent || '{}');
  const form = document.querySelector<HTMLFormElement>('[data-calc]')!;
  const nf = new Intl.NumberFormat(cfg.locale, { maximumFractionDigits: 0 });
  const eur = (n: number) => nf.format(Math.round(n)) + ' €';
  const num = (n: string) => Number((form.elements.namedItem(n) as HTMLInputElement).value);
  const set = (k: string, v: string) => {
    const el = document.querySelector(`[data-r="${k}"]`);
    if (el) el.textContent = v;
  };
  const out = (k: string, v: string) => {
    const el = form.querySelector(`[data-out="${k}"]`);
    if (el) el.textContent = v;
  };
  function update() {
    const preu = num('preu');
    const nits = num('nits');
    const pct = num('pct');
    const directe = num('directe');
    out('preu', `${preu} €`);
    out('nits', `${nits} ${cfg.any}`);
    out('pct', `${pct} %`);
    out('directe', `${directe} %`);
    const comissions = preu * nits * (pct / 100);
    const estalvi = comissions * (directe / 100);
    const net = estalvi - cfg.costAny;
    const perNit = preu * (pct / 100);
    set('comissions', eur(comissions));
    set('estalvi', eur(estalvi));
    set('net', eur(net));
    set('netLabel', net >= 0 ? cfg.net : cfg.perdua);
    set('nitsMin', String(perNit > 0 ? Math.ceil(cfg.costAny / perNit) : 0));
    document.querySelector('[data-total]')?.classList.toggle('is-neg', net < 0);
  }
  form.addEventListener('input', update);
  update();
</script>

<style>
  .calc-hero {
    padding-block: clamp(56px, 9vw, 112px) clamp(56px, 8vw, 96px);
  }
  .calc-title {
    max-width: 18ch;
    font-size: clamp(2.5rem, 6.4vw, 4.5rem);
    line-height: 1.02;
  }
  .calc-lede {
    margin-top: 22px;
  }
  .calc {
    display: grid;
    gap: 40px;
    align-items: start;
  }
  .calc-form {
    display: grid;
    gap: 3px;
    padding: 3px;
    background: var(--joint-lime);
    border-radius: 4px;
  }
  .field {
    display: grid;
    gap: 14px;
    padding: clamp(20px, 3vw, 28px);
    background: var(--face);
  }
  .field-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    font-weight: 600;
  }
  .field output {
    flex: none;
    font-family: var(--display);
    font-size: 1.625rem;
    line-height: 1;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .field small {
    color: var(--ink-muted);
    font-size: 0.9375rem;
    line-height: 1.45;
  }
  .field input[type='range'] {
    width: 100%;
    height: 32px;
    margin: 0;
    accent-color: var(--lichen-ink);
    cursor: pointer;
  }
  .result {
    display: grid;
    gap: 22px;
    padding: clamp(26px, 4vw, 44px);
    border-radius: 4px;
    background:
      linear-gradient(rgb(19 21 23 / 0.9), rgb(19 21 23 / 0.9)),
      url('/img/basalt.webp') 40% 30% / cover no-repeat;
    color: #f2f1ed;
  }
  .result-head {
    color: var(--mist);
    font-weight: 650;
  }
  .rows {
    display: grid;
    margin: 0;
  }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid rgb(255 255 255 / 0.12);
  }
  .row dt small {
    display: block;
    color: var(--mist);
    font-size: 0.875rem;
  }
  .row dd {
    margin: 0;
    flex: none;
    font-variant-numeric: tabular-nums;
    font-weight: 650;
    font-size: 1.125rem;
  }
  .row-total {
    border-bottom: 0;
    padding-top: 20px;
  }
  .row-total dt {
    font-weight: 650;
  }
  .row-total dd {
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(2.5rem, 7vw, 3.5rem);
    line-height: 1;
    color: var(--lichen-hi);
  }
  .row-total.is-neg dd {
    color: var(--mist-2);
  }
  .breakeven {
    color: var(--mist-2);
  }
  .breakeven strong {
    color: #f2f1ed;
    font-size: 1.25rem;
  }
  .result-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
  }
  .note {
    color: var(--mist);
    font-size: 0.875rem;
    line-height: 1.5;
  }
  @media (min-width: 960px) {
    .calc {
      grid-template-columns: 1fr 1fr;
      gap: 48px;
    }
    .result {
      position: sticky;
      top: calc(var(--header-h) + 24px);
    }
  }
</style>
